# Chanjet T+Cloud credentials
CHANJET_APP_KEY=
CHANJET_APP_SECRET=

# Optional legacy single-account tokens. Prefer OAuth setup for multi-account use.
CHANJET_OPEN_TOKEN=
CHANJET_REFRESH_TOKEN=

# Optional multi-account token store settings
CHANJET_ACTIVE_ACCOUNT=
CHANJET_TOKEN_STORE_PATH=.chanjet_tokens.json

# Optional endpoint overrides
CHANJET_BASE_URL=https://openapi.chanjet.com
CHANJET_DOCS_API_URL=https://openapi.chanjet.com/developer/api
CHANJET_TIMEOUT_SECONDS=30
